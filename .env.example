APP_NAME="Zonix Pharma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URLs de tiendas (landing web). Dejar vacío para modal "Próximamente".
APP_STORE_URL=
PLAY_STORE_URL=
# APK Android (piloto). Si PLAY_STORE_URL está vacío, la landing usa este enlace.
# Archivo en public/downloads/zonix-pharma.apk (no versionado; ver docs/ops/deploy/DEPLOY_PHARMA_AIBLOCK.md).
ANDROID_APK_URL=/downloads/zonix-pharma.apk

# CORS (navegadores / SPA). Lista separada por comas. En producción definir dominios reales.
# Nunca usar solo * con credenciales; si necesitas comodín, el backend desactiva supports_credentials automáticamente.
# Ejemplo producción: CORS_ALLOWED_ORIGINS=https://app.ejemplo.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
# CORS_SUPPORTS_CREDENTIALS=true

# Opcional: fecha ISO8601 del último respaldo (muestra en GET /api/admin/system-health si está definida).
# LAST_BACKUP_AT=2026-04-01T12:00:00Z

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Zonix: servicios externos y valores por defecto (no hardcode en código)
# Routing (cascada en backend): ORS opcional → Valhalla → OSRM FOSSGIS → OSRM demo → interpolado
# ZONIX_ORS_API_KEY=                    # OpenRouteService (HeiGIT); si vacío se omite
# ZONIX_ORS_DIRECTIONS_BASE=https://api.openrouteservice.org/v2/directions
# ZONIX_VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
ZONIX_OSRM_FOSSGIS_BASE_URL=https://routing.openstreetmap.de/routed-car
ZONIX_OSRM_DEMO_BASE_URL=https://router.project-osrm.org
ZONIX_OSRM_BASE_URL=https://router.project-osrm.org
# ZONIX_ROUTING_HTTP_TIMEOUT=5
ZONIX_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
ZONIX_NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
ZONIX_DEFAULT_DELIVERY_FEE=5.00
ZONIX_DEFAULT_PREPARATION_TIME_MINUTES=12
ZONIX_ANALYTICS_DELIVERY_TIME_P1=32.5
ZONIX_ANALYTICS_DELIVERY_TIME_P2=28.5
ZONIX_ANALYTICS_AVG_PREP_FALLBACK=12.5
ZONIX_ANALYTICS_SATISFACTION_FALLBACK=4.5
ZONIX_SEEDER_DEMO_ORDER_ID=4
ZONIX_SEEDER_DEMO_ORDER_IDS=4,5
ZONIX_SEEDER_DEFAULT_DELIVERY_FEE=5.00

# Máximo de pedidos activos por comprador (no entregados ni cancelados). 0 = ilimitado.
ZONIX_BUYER_MAX_CONCURRENT_OPEN_ORDERS=7

# Auto-cancelar pending_payment sin pago (comando zonix:expire-pending-payment-orders, agendado en Kernel).
# Requiere en dev: `php artisan schedule:work` (mejor que `composer run schedule-work`, ver timeout 300s en AGENTS.md). En prod: cron `* * * * * php artisan schedule:run`.
# Si la BD se creó antes de esta columna: ALTER TABLE orders ADD COLUMN approved_for_payment_at TIMESTAMP NULL AFTER approved_for_payment;
ZONIX_EXPIRE_PENDING_PAYMENT_ENABLED=true
# 0 = desactiva la regla. Default: 24 h desde creación del pedido.
ZONIX_PENDING_PAYMENT_MAX_AGE_MINUTES=1440
# 0 = desactiva. Default: 60 min desde approved_for_payment_at (cuando el comercio aprobó para pagar).
ZONIX_PENDING_PAYMENT_AFTER_APPROVAL_MINUTES=60
# Si true: no cancela por TTL mientras haya comprobante subido pendiente de validación (order_payments o campos legacy en orders).
ZONIX_EXPIRE_SKIP_IF_PROOF_PENDING=true

# Ruta repartidor→cliente: waypoint opcional (ej. Iglesia Evangelio del Reino). Si se define, la ruta pasa por este punto.
ZONIX_TRACKING_WAYPOINT_LAT=10.138407
ZONIX_TRACKING_WAYPOINT_LNG=-68.0290678

# Firebase Cloud Messaging (FCM) — proyecto Firebase de Zonix Pharma.
# Ruta al JSON de cuenta de servicio: nombre de archivo dentro de storage/app/ o ruta absoluta.
# Ejemplo: firebase-zonix-pharma.json (se busca en storage/app/)
# No commitear el archivo JSON; añadirlo solo en el servidor.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

# Google Sign-In (login móvil): ID de cliente OAuth tipo "Aplicación web" (mismo valor que GOOGLE_SIGN_IN_SERVER_CLIENT_ID en Flutter .env).
# No uses el client_id del cliente "Android" de google-services.json. Si está vacío, el backend no comprueba el claim aud del id_token.
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────
# Zonix Pharma · reglas farmacéuticas (Rx + farmacéutico colegiado)
# ─────────────────────────────────────────────────────────────────
# Default false: el comprador puede crear el pedido en pending_prescription_validation
# y subir la receta después (MVP). Poner true solo cuando el cliente ya envía
# prescription_id de una receta approved (preorden / modo estricto).
ZONIX_PHARMA_BLOCK_RX_WITHOUT_PRESCRIPTION=false
# TTL en minutos para que un farmacéutico colegiado valide una receta
# pendiente; si vence se cancela el pedido (estado pending_prescription_validation).
ZONIX_PHARMA_PRESCRIPTION_VALIDATION_TTL_MINUTES=60
# Si true, NO se permite aplicar promociones/cupones a líneas de productos Rx.
ZONIX_PHARMA_DISALLOW_PROMOTIONS_ON_RX=true
# Si true, los productos con cold_chain=true se restringen a delivery con
# cadena de frío o a retiro en tienda (la app muestra advertencia).
ZONIX_PHARMA_REQUIRE_COLD_CHAIN_HANDLING=true
# Hosts permitidos si image_url es URL externa (coma-separados). Vacío = no se aceptan http(s) externos en recetas.
# ZONIX_PHARMA_PRESCRIPTION_IMAGE_HOSTS=cdn.ejemplo.com
# Límite de subidas de receta por minuto y usuario (throttle dedicado).
ZONIX_PHARMA_PRESCRIPTION_UPLOAD_PER_MINUTE=8
# Días tras estado terminal (approved/rejected/expired) para purgar datos personales de recetas (comando agendado).
ZONIX_PHARMA_PRESCRIPTION_RETENTION_DAYS=90

# CORS: cabeceras permitidas en preflight (lista separada por comas). No usar * en producción con credenciales.
# CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Requested-With

# Colas: en producción usar redis + Horizon (`php artisan horizon`). Requiere QUEUE_CONNECTION=redis.
# QUEUE_CONNECTION=redis
